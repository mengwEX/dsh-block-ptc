{
  "name": "dsh-block-ptc",
  "version": "0.2.1",
  "description": "Blackboard blocks for DeepSeek Harness PTC mode: block_run_code assigns block ids to program messages, and block_summary replaces their complete interval with a model-written summary that inherits the remaining ids.",
  "type": "module",
  "license": "MIT",
  "author": "WangMeng <mengw.ex@gmail.com> (https://github.com/mengwEX)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mengwEX/dsh-block-ptc.git"
  },
  "homepage": "https://github.com/mengwEX/dsh-block-ptc#readme",
  "bugs": {
    "url": "https://github.com/mengwEX/dsh-block-ptc/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "ptc",
    "context",
    "compaction",
    "agent"
  ],
  "main": "lib/plugin.js",
  "exports": {
    ".": "./lib/plugin.js",
    "./client": "./client/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib/*.js",
    "client/client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md",
    "README.zh.md",
    "RELEASING.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.4",
    "@deepseek-ai/dsh-agent": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-session": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2"
  },
  "scripts": {
    "test": "node tests/logic.test.mjs && node tests/client.test.mjs",
    "check": "node --check lib/plugin.js && node --check lib/blocks.js && node --check client/client.js && node --check tests/logic.test.mjs && node --check tests/client.test.mjs && npm test",
    "test:client": "node --check client/client.js",
    "prepack": "npm run check"
  }
}
