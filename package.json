{
  "name": "dsh-block-ptc",
  "version": "0.1.0",
  "description": "Blackboard blocks for DeepSeek Harness PTC mode: block_run_code tags every program run with a block id, and block_summary replaces a finished block's messages with a summary the model writes itself.",
  "type": "module",
  "license": "MIT",
  "author": "WangMeng <mengw.ex@gmail.com> (https://github.com/mengwEX)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mengwEX/dsh-block-ptc.git"
  },
  "homepage": "https://github.com/mengwEX/dsh-block-ptc#readme",
  "bugs": {
    "url": "https://github.com/mengwEX/dsh-block-ptc/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "ptc",
    "context",
    "compaction",
    "agent"
  ],
  "main": "lib/plugin.js",
  "exports": {
    ".": "./lib/plugin.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib/plugin.js",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md",
    "README.zh.md",
    "RELEASING.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2"
  },
  "scripts": {
    "test": "node tests/logic.test.mjs",
    "check": "node --check lib/plugin.js && node --check tests/logic.test.mjs && npm test",
    "prepack": "npm run check"
  }
}
